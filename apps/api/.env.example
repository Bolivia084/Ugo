# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://ugo:ugo_dev_password@localhost:5432/ugo_dev
# At least 32 random bytes each: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me-1234
# Ed25519 private key (PKCS8 PEM, base64 encoded) used to sign offline entitlements.
# Generate with: npm run keys:entitlement
ENTITLEMENT_SIGNING_KEY=
# 32 bytes base64, used to encrypt TOTP secrets: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=
CORS_ORIGINS=http://localhost:5173
# Admin dashboard: comma separated IPs or CIDRs allowed to call /admin routes. Empty means no IP check (development only).
ADMIN_IP_ALLOWLIST=
# AI tutor. All calls go through this API; the key never ships in the app.
ANTHROPIC_API_KEY=
TUTOR_MODEL=claude-opus-5-5
# Payments
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=
APPLE_BUNDLE_ID=ng.ugo.app
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
GOOGLE_PACKAGE_NAME=ng.ugo.app
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_RTDN_AUDIENCE=
# Storage for content packs and media. "local" writes to ./storage in development.
STORAGE_DRIVER=local
S3_BUCKET=
CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY=
# Email and push
EMAIL_DRIVER=log
EMAIL_FROM=Ugo <no-reply@ugo.ng>
FCM_SERVICE_ACCOUNT_JSON=
SENTRY_DSN=
