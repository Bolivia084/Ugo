{
  "name": "@ugo/api",
  "version": "0.0.1",
  "description": "Ugo backend API (NestJS)",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "keys:entitlement": "node -e \"const c=require('crypto');const k=c.generateKeyPairSync('ed25519');console.log(k.privateKey.export({format:'der',type:'pkcs8'}).toString('base64'))\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prebuild": "npm --prefix ../../packages/shared run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@apple/app-store-server-library": "^3.1.0",
    "@aws-sdk/client-s3": "^3.1177.0",
    "@aws-sdk/client-sesv2": "^3.1177.0",
    "@aws-sdk/cloudfront-signer": "^3.1177.0",
    "@aws-sdk/s3-request-presigner": "^3.1177.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.5",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/schedule": "^12.0.4",
    "@nestjs/throttler": "^6.8.0",
    "@prisma/client": "^6.19.3",
    "@sentry/node": "^11.17.0",
    "@ugo/shared": "file:../../packages/shared",
    "argon2": "^0.45.2",
    "google-auth-library": "^11.3.4",
    "helmet": "^8.3.0",
    "prisma": "^6.19.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=22"
  }
}
